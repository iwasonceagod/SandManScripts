local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- ==================== WINDOW ====================
local Window = Rayfield:CreateWindow({
   Name = "SandMan's One Piece Incremental Hub 🏴‍☠️⚔️💰",
   LoadingTitle = "Loaded",
   LoadingSubtitle = "by Mr.Sandman",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "SandManHub",
      FileName = "OnePieceIncremental_v3"
   },
   KeySystem = false
})

-- ==================== AUTO WORK TAB ====================
local WorkTab = Window:CreateTab("⚒️ Auto Work", 4483362458)
WorkTab:CreateSection("All Jobs Available")

local jobList = {
   "odd_jobs",
   "fishing", 
   "bounty_hunt",
   "treasure_map",
   "raiding",
   "grand_heist",
   "warlord_contract",
   "emperor_route"
}

local selectedJob = "fishing"
local autoWork = false

WorkTab:CreateDropdown({
   Name = "Select Job",
   Options = jobList,
   CurrentOption = {"fishing"},
   Callback = function(Value)
      selectedJob = Value[1]
      Rayfield:Notify({
         Title = "Job Selected",
         Content = selectedJob:gsub("_", " "):gsub("^%l", string.upper),
         Duration = 4
      })
   end
})

WorkTab:CreateToggle({
   Name = "🔄 Auto Work (Selected Job)",
   CurrentValue = false,
   Callback = function(Value)
      autoWork = Value
      if Value then
         Rayfield:Notify({
            Title = "Auto Work ENABLED",
            Content = "Fast spamming " .. selectedJob:gsub("_", " "):gsub("^%l", string.upper),
            Duration = 6
         })
         task.spawn(function()
            while autoWork do
               pcall(function()
                  ReplicatedStorage.RemoteEvents.DoWork:FireServer(selectedJob)
               end)
               task.wait(0.02)  -- Fast 20ms delay
            end
         end)
      else
         Rayfield:Notify({Title = "Auto Work DISABLED", Duration = 4})
      end
   end
})

