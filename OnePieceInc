-- ==================== AUTO ALL JOBS TAB ====================
local AllJobsTab = Window:CreateTab("🔄 Auto All Jobs", 4483362458)
AllJobsTab:CreateSection("Spam Every Job (Fast Rotation)")

local autoAllJobs = false
AllJobsTab:CreateToggle({
   Name = "🔄 Auto All Jobs (Rotates All 8)",
   CurrentValue = false,
   Callback = function(Value)
      autoAllJobs = Value
      if Value then
         Rayfield:Notify({
            Title = "Auto All Jobs ENABLED",
            Content = "Fast rotation through all 8 jobs (10ms)",
            Duration = 6
         })
         task.spawn(function()
            while autoAllJobs do
               for _, job in ipairs(jobList) do
                  if not autoAllJobs then break end
                  pcall(function()
                     ReplicatedStorage.RemoteEvents.DoWork:FireServer(job)
                  end)
                  task.wait(0.01)  -- Ultra-fast 10ms rotation
               end
            end
         end)
      else
         Rayfield:Notify({Title = "Auto All Jobs DISABLED", Duration = 4})
      end
   end
})

