local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- ==================== WINDOW ====================
local Window = Rayfield:CreateWindow({
   Name = "SandMan's 1 Click = 1 Growth Hub",
   LoadingTitle = "Loaded",
   LoadingSubtitle = "by Mr.Sandman",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "SandManHub",
      FileName = "GrowthScript"
   },
   KeySystem = false
})

-- ==================== MAIN TAB ====================
local MainTab = Window:CreateTab("🔥 Main", 4483362458)

MainTab:CreateSection("Get Max Level")

local getMaxLevel = false

MainTab:CreateToggle({
   Name = "⭐ Get Max Level",
   CurrentValue = false,
   Callback = function(Value)
      getMaxLevel = Value
      if Value then
         Rayfield:Notify({Title = "Get Max Level ENABLED", Duration = 5})
         task.spawn(function()
            while getMaxLevel do
               local args = {
                  "Gift1"
               }
               ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("ClaimItem"):FireServer(unpack(args))
               task.wait(0)
            end
         end)
      else
         Rayfield:Notify({Title = "Get Max Level DISABLED", Duration = 5})
      end
   end
})

